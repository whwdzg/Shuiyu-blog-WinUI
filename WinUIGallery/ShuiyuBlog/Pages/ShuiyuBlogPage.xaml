<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUIGallery.ShuiyuBlog.Pages.ShuiyuBlogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinUIGallery.ShuiyuBlog.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:WinUIGallery.ShuiyuBlog.Models"
    mc:Ignorable="d">

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="水鱼 Blog" />
            <TextBlock Opacity="0.8" Text="Shuiyu Blog · WinUI 3 Native Archive" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ComboBox
                x:Name="SectionComboBox"
                Header="分区"
                SelectionChanged="SectionComboBox_SelectionChanged" />

            <TextBox
                x:Name="SearchTextBox"
                Grid.Column="1"
                Header="搜索"
                PlaceholderText="按标题、路径、摘要搜索"
                TextChanged="SearchTextBox_TextChanged" />
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <ListView
                x:Name="EntryListView"
                IsItemClickEnabled="True"
                ItemClick="EntryListView_ItemClick"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="model:BlogEntry">
                        <Border Margin="0,0,0,8" Padding="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                            <StackPanel Spacing="4">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" TextWrapping="WrapWholeWords" />
                                <TextBlock Opacity="0.85" Text="{x:Bind RelativePath}" TextWrapping="WrapWholeWords" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Section}" />
                                    <TextBlock Opacity="0.6" Text="|" />
                                    <TextBlock Text="{x:Bind FileType}" />
                                </StackPanel>
                                <TextBlock MaxLines="2" Opacity="0.8" Text="{x:Bind Summary}" TextTrimming="CharacterEllipsis" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border
                Grid.Column="1"
                Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8">
                <ScrollViewer>
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="DetailTitleTextBlock" FontSize="22" FontWeight="SemiBold" Text="请选择左侧内容" TextWrapping="WrapWholeWords" />
                        <TextBlock x:Name="DetailPathTextBlock" Opacity="0.75" TextWrapping="WrapWholeWords" />
                        <TextBlock x:Name="DetailMetaTextBlock" Opacity="0.75" TextWrapping="WrapWholeWords" />
                        <TextBox
                            x:Name="DetailTextBox"
                            AcceptsReturn="True"
                            IsReadOnly="True"
                            MinHeight="400"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
