<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUIGallery.ShuiyuBlog.Pages.NativeDocumentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:WinUIGallery.ShuiyuBlog.Models"
    mc:Ignorable="d">

    <Grid Padding="20" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock x:Name="TitleTextBlock" FontSize="28" FontWeight="SemiBold" Text="原生页面" TextWrapping="WrapWholeWords" />
            <TextBlock x:Name="MetaTextBlock" Opacity="0.75" TextWrapping="WrapWholeWords" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">
                <Expander Header="正文（原生解析）" IsExpanded="True">
                    <TextBox x:Name="ContentTextBox" AcceptsReturn="True" IsReadOnly="True" MinHeight="300" TextWrapping="Wrap" />
                </Expander>

                <Expander Header="图片" IsExpanded="True">
                    <ItemsRepeater x:Name="ImageRepeater">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="10" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="model:NativeDocumentImageItem">
                                <Border Padding="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                                    <StackPanel Spacing="8">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                        <Image Source="{x:Bind SourcePath}" MaxHeight="260" Stretch="Uniform" />
                                        <TextBlock Opacity="0.7" Text="{x:Bind SourcePath}" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Expander>

                <Expander Header="外部链接" IsExpanded="True">
                    <ItemsRepeater x:Name="LinkRepeater">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="model:NativeDocumentLinkItem">
                                <Border Padding="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                                    <StackPanel Spacing="6">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" TextWrapping="WrapWholeWords" />
                                        <TextBlock Opacity="0.7" Text="{x:Bind Url}" TextWrapping="WrapWholeWords" />
                                        <Button Content="打开链接" Tag="{x:Bind Url}" Click="OpenLinkButton_Click" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
